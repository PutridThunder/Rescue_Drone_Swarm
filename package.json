{
  "name": "sar-drone-swarm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data": "node scripts/fetch-world.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eo:setup": "python3 -m venv .venv && .venv/bin/pip install -r pipeline/requirements.txt",
    "eo": "cd pipeline && ../.venv/bin/python -W ignore -m rescue_eo --all",
    "eo:test": "cd pipeline && ../.venv/bin/python -m pytest -q",
    "area": "node scripts/build-area.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
