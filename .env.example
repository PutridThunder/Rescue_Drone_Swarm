# DeepSearch (Gemini). Server-side only: never prefix with VITE_ (that would ship it to browsers).
# Local dev: copy to .env.local. Production: set it in Vercel > Project > Settings > Environment Variables.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash. Comma-separate several to fall back when one is out of quota.
GEMINI_MODEL=
