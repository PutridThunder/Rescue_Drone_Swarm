# Optional free API keys for online crowd intel. Copy to .env.local and fill in what you have.
# Crowd intel works without any of these (OpenStreetMap + Mastodon need no key).

# Ticketmaster Discovery API (free): https://developer.ticketmaster.com -> My Apps -> Consumer Key
TICKETMASTER_API_KEY=

# Reddit "script" app (free): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky app password (free): bsky.app -> Settings -> Privacy and security -> App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
