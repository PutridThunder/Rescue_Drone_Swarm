# Snowflake storage (optional). Server-side only: never prefix with VITE_ (that ships it to browsers).
# Local dev: copy to .env.local. Production: Vercel > Project > Settings > Environment Variables.
# Values come from snowflake/setup.sql (see README).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
# Optional (these are the defaults)
SNOWFLAKE_WAREHOUSE=RESCUE_WH
SNOWFLAKE_DATABASE=RESCUE_DRONES
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_ROLE=RESCUE_APP
